
<!DOCTYPE html>
<html>
<head>
    <title>Image Toggle</title>

    <style>
        #message {
            font-size: 20px;
            color: navy;
            cursor: pointer;
        }

        #message:hover {
            color: red;
            font-weight: bold;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <h2>Click the Image to Toggle</h2>

    <img id="photo"
         src="https://placehold.co/250x150/2563eb/ffffff?text=Image+One"
         alt="Image One"
         width="250"
         onclick="toggleImage()">

    <p id="message">Move the mouse over this text.</p>

    <script>
        let firstImage = true;

        function toggleImage() {
            let image = document.getElementById("photo");

            if (firstImage) {
                image.src =
                    "https://placehold.co/250x150/16a34a/ffffff?text=Image+Two";
                image.alt = "Image Two";
            } else {
                image.src =
                    "https://placehold.co/250x150/2563eb/ffffff?text=Image+One";
                image.alt = "Image One";
            }

            firstImage = !firstImage;
        }
    </script>
</body>
</html>
