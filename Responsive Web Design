<!DOCTYPE html>
<html>
<head>
    <title>Responsive Webpage</title>
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        header {
            background: navy;
            color: white;
            padding: 2rem;
            text-align: center;
        }

        .content {
            display: flex;
            gap: 1rem;
            padding: 2%;
        }

        .card {
            flex: 1;
            background: #dbeafe;
            padding: 2rem;
        }

        img {
            max-width: 100%;
            height: auto;
        }

        @media (max-width: 600px) {
            .content {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <header>
        <h1>Responsive Website</h1>
    </header>

    <div class="content">
        <div class="card">Section One</div>
        <div class="card">Section Two</div>
        <div class="card">Section Three</div>
    </div>
</body>
</html>
