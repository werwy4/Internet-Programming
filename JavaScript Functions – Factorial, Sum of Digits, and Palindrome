Create another file named index.html in the same folder.
<!DOCTYPE html>
<html>
<head>
    <title>JavaScript Operations</title>
</head>
<body>
    <h2>Select an Operation</h2>

    <select id="operation">
        <option value="factorial">Factorial</option>
        <option value="sum">Sum of Digits</option>
        <option value="palindrome">Palindrome</option>
    </select>

    <input type="text" id="input"
           placeholder="Enter number or text">

    <button onclick="executeOperation()">Execute</button>

    <p id="result"></p>

    <script src="operations.js"></script>

    <script>
        function executeOperation() {
            let operation =
                document.getElementById("operation").value;

            let input =
                document.getElementById("input").value.trim();

            let result;

            if (input === "") {
                result = "Please enter a value.";
            } else if (operation === "factorial") {
                if (!/^\d+$/.test(input)) {
                    result = "Enter a non-negative integer.";
                } else {
                    result = factorial(Number(input));
                }
            } else if (operation === "sum") {
                if (!/^-?\d+$/.test(input)) {
                    result = "Enter an integer.";
                } else {
                    result = sumDigits(Number(input));
                }
            } else {
                result = isPalindrome(input)
                    ? "The string is a palindrome."
                    : "The string is not a palindrome.";
            }

            document.getElementById("result").textContent =
                "Result: " + result;
        }
    </script>
</body>
</html>
